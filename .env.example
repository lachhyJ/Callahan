# Variables Docker Compose interpolates into docker-compose.prod.yml.
#
# Copy to `.env` beside the compose file on the deploy host and fill in the
# real value. This file holds host paths, not secrets — it's kept out of the
# repo because the path is a personal directory, not because it's sensitive.
#
# deploy.sh's `git reset --hard` does not touch untracked files, so a `.env`
# placed here survives every deploy. It is NOT created by the deploy, so a new
# host needs it set up once by hand before the first `docker compose up`.

# Host directory holding the training program PDF. Mounted read-only at
# /app/ProgramDocs, which is what ProgramPdf__Path in backend.prod.env points
# into — so the container side is fixed and only this host side varies.
# The PDF lives in Nextcloud rather than the repo; see docs/program-sync.md.
PROGRAM_DOCS_HOST_PATH=/path/to/nextcloud-data/<user>/files/<...>/Fris Resources
