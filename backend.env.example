# Copy to backend.env and fill in real values. Never commit backend.env itself.
# Deliberately NOT named .env — Docker Compose auto-loads a file literally named
# .env for its own variable substitution, which mangles $ characters in a bcrypt
# hash (truncates it at the first unresolved $var). Keep this name as-is.
Auth__Username=
Auth__PasswordHash=
Auth__JwtSecret=
