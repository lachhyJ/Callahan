# Copy to backend.env and fill in real values. Never commit backend.env itself.
# Deliberately NOT named .env — Docker Compose auto-loads a file literally named
# .env for its own variable substitution, which mangles $ characters in a bcrypt
# hash (truncates it at the first unresolved $var). Keep this name as-is.
Auth__Username=
Auth__PasswordHash=
Auth__JwtSecret=
# Generate with WebPush.VapidHelper.GenerateVapidKeys() — safe to reuse the same
# pair across dev/prod, these identify the app to push services, not an access secret.
Vapid__PublicKey=
Vapid__PrivateKey=
Vapid__Subject=mailto:you@example.com
# API key for the AI taper-consult feature (console.anthropic.com). Leave blank
# to disable the consult endpoint gracefully — it 503s with a clear message,
# the rest of the taper page (deterministic recommendation, check-ins) keeps
# working regardless.
Anthropic__ApiKey=
# Key for the iOS home screen widget (GET /api/widget/training-status, header
# X-Widget-Key). Leave blank and that route 404s as if it didn't exist. It
# authenticates only that route, but it is baked into the app build, so treat it
# as a credential. Generate with: openssl rand -hex 32
# The same value goes in frontend/ios/App/CallahanWidgets/Widget.local.xcconfig.
Widget__Key=
