# Copy to an env file on the host, outside the repo (e.g. next to the app's data directory)
# and load it before running garmin_sync.py — never commit real values.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme

# The backend's compose service name, as the cron's `docker run --network`
# sees it. Use http://localhost:8080 only when running the script outside Docker.
CALLAHAN_API_BASE=http://backend:8080
CALLAHAN_USERNAME=your-username
CALLAHAN_PASSWORD=changeme

# Optional overrides — defaults are fine for a single NAS cron job.
# GARMIN_TOKENSTORE=~/.garminconnect
# CALLAHAN_TOKEN_CACHE=~/.callahan_sync_token

# --- garmin-sync-trigger service only (the app's "Sync Garmin" button) ---
# Shared secret between the backend and the trigger container. Optional: if
# unset, the trigger accepts any request from the compose network. If set,
# the backend must send the same value as Sync__TriggerToken in backend.prod.env.
# TRIGGER_TOKEN=
# TRIGGER_PORT=8099
# TRIGGER_SYNC_DAYS=14
# TRIGGER_WELLNESS_DAYS=3
