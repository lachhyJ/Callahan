# Copy to backend.prod.env on the NAS and fill in real values. Never commit backend.prod.env.
# Use different values from backend.env (local dev) — a production credential and JWT secret.
# Escape literal $ as $$ in Auth__PasswordHash (bcrypt hashes contain $ — Compose v2 interpolates
# env_file contents, so an unescaped $ gets treated as a variable reference and truncated).
Auth__Username=
Auth__PasswordHash=
Auth__JwtSecret=
# Fine to reuse the same VAPID pair as local dev — these identify the app to
# push services, not an access-control secret like the auth credential above.
Vapid__PublicKey=
Vapid__PrivateKey=
Vapid__Subject=mailto:you@example.com
# API key for the AI taper-consult feature (console.anthropic.com). Leave blank
# to disable the consult endpoint gracefully — it 503s with a clear message,
# the rest of the taper page (deterministic recommendation, check-ins) keeps
# working regardless.
Anthropic__ApiKey=
# Path inside the container to the program PDF, matching the volume mount
# in docker-compose.prod.yml. Leave unset and the /api/program/pdf endpoint
# just 404s cleanly — that's fine for local dev, where this file doesn't exist.
ProgramPdf__Path=/app/ProgramDocs/ultimate_athlete_program.pdf
# The "Sync Garmin" button proxies to the garmin-sync-trigger container.
# Leave TriggerBaseUrl blank to disable the button gracefully (it 502s with a
# clear message). TriggerToken is optional; when set it must match
# TRIGGER_TOKEN in /mnt/tank/callahan-data/garmin-sync.env.
Sync__TriggerBaseUrl=http://garmin-sync-trigger:8099
Sync__TriggerToken=
