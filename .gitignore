# Python
__pycache__/
*.pyc

# Secrets
backend.env
backend.prod.env
!backend.env.example
!backend.prod.env.example

# Compose variable interpolation (host paths, not secrets) — see .env.example
.env
!.env.example

# OS
.DS_Store

# Claude Code — local-only settings and other threads' worktrees
.claude/settings.local.json
.claude/worktrees/
